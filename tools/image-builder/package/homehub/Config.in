config BR2_PACKAGE_HOMEHUB
	bool "Home Hub service suite"
	depends on BR2_USE_MMU
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_HOST_RUSTC
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_SQLITE
	help
	  Builds hh-service, hh-session and hh-tools from the local locked
	  Rust workspace. Runtime units and user policy are separate board
	  integration work.
